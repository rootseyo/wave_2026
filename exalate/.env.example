# ==============================================================================
# Jira Data Center & Exalate Configuration (Compatible with ../env)
# ==============================================================================

# Target environment to use by default if --target is not passed:
# JIRA_DC_OPS (Operations / Production) or JIRA_DC_STG (Staging)
JIRA_TARGET_ENV=JIRA_DC_OPS

# ------------------------------------------------------------------------------
# 1. Jira Data Center Operations (OPS / Production)
# ------------------------------------------------------------------------------
JIRA_DC_OPS_URL=https://jira-ops.example.com
JIRA_DC_OPS_API_TOKEN=your_ops_bearer_pat_token
JIRA_DC_OPS_USERNAME=admin
JIRA_DC_OPS_PASSWORD=your_ops_password

# ------------------------------------------------------------------------------
# 2. Jira Data Center Staging (STG)
# ------------------------------------------------------------------------------
JIRA_DC_STG_URL=https://jira-stg.example.com
JIRA_DC_STG_API_TOKEN=your_stg_bearer_pat_token
JIRA_DC_STG_USERNAME=admin
JIRA_DC_STG_PASSWORD=your_stg_password

# ------------------------------------------------------------------------------
# 3. SSL Certificate Verification
# ------------------------------------------------------------------------------
# Set to false for internal DC instances with self-signed certs (suppresses warnings)
JIRA_SSL_VERIFY=false
# VERIFY_SSL=false

# ------------------------------------------------------------------------------
# 4. Execution Settings
# ------------------------------------------------------------------------------
OUTPUT_DIR=./output
REQUEST_TIMEOUT=30
MAX_RETRIES=5
PAGE_SIZE=50
MAX_PAGES=1000

# ------------------------------------------------------------------------------
# 5. Exalate configuration endpoint overrides (optional)
# ------------------------------------------------------------------------------
# These endpoints are deployment/version-specific and are not assumed by the
# public monitoring API. Set them only after confirming the GET endpoint with
# the Exalate vendor or your Jira administrator.
# EXALATE_CONNECTIONS_ENDPOINT=/rest/issuehub/4.0/connections
# EXALATE_TRIGGERS_ENDPOINT=/rest/issuehub/4.0/triggers

# ------------------------------------------------------------------------------
# 6. Generic Fallback (Optional)
# ------------------------------------------------------------------------------
# JIRA_BASE_URL=https://jira.example.com
# JIRA_PAT=your_token
# JIRA_USERNAME=admin
# JIRA_PASSWORD=secret
